# Copy to .env and fill in before running docker compose up.
#
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Must be the same value in BOTH the Python API and the Go scheduler.
# Generate a fresh one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-dev-secret-change-me

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=transit
# Published host port for psql / pgAdmin access (the services connect internally):
# POSTGRES_PORT=5433

# ── Routing provider (scheduler service) ─────────────────────────────────────
# haversine — offline straight-line estimate; works everywhere, no data needed
# osrm      — real road times; start with --profile osrm; needs osrm-data/ (see README)
# tomtom    — real road times with live traffic; requires TOMTOM_API_KEY
ROUTING_PROVIDER=haversine
# TOMTOM_API_KEY=

# ── Solver (scheduler service) ────────────────────────────────────────────────
# vroom   — production solver (requires bin/vroom binary — see README)
# greedy  — test-only nearest-neighbour stand-in; no binary needed
SOLVER=vroom

# ── Python API settings ────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOW_SIMULATION=true
REPORT_AI=rules

# ── Ports ─────────────────────────────────────────────────────────────────────
# SCHEDULER_PORT=8080
